<?xml version="1.0"?>
<ruleset name="landtech-extras-for-elementor">
	<description>Text domain hygiene: plugin gettext uses landtech-extras-for-elementor; some Elementor-context strings still use elementor / elementor-pro.</description>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>

	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/lib/*</exclude-pattern>
	<exclude-pattern>*/scripts/*</exclude-pattern>

	<config name="minimum_supported_wp_version" value="6.0"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="landtech-extras-for-elementor"/>
				<element value="elementor"/>
				<element value="elementor-pro"/>
			</property>
		</properties>
	</rule>

	<!-- Dynamic messages (sprintf/concat): still localized; enforcing a single AST string node is too brittle for legacy admin notices. -->
	<rule ref="WordPress.WP.I18n.NonSingularStringLiteralText">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.WP.I18n.NonSingularStringLiteralDomain">
		<severity>0</severity>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="landtech"/>
				<element value="landtech_extras"/>
				<element value="ltxe"/>
				<element value="LandTechExtras"/>
				<element value="LANDTECH_EXTRAS"/>
			</property>
		</properties>
	</rule>
</ruleset>
